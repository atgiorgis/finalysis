<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.finalysis</groupId>
    <artifactId>finalysis-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>finalysis-backend</name>
    <description>Finalysis REST API</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <pgvector.version>0.1.6</pgvector.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <!-- Fingerprint-relevant: extracted PDF text feeds transaction fingerprints. Upgrade manually,
             never automatically (docs/plans/phase-3b.md §1.3). -->
        <pdfbox.version>3.0.8</pdfbox.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- The AWS SDK version Spring AI 2.0.1's Bedrock modules bring; keep them equal when upgrading. -->
        <aws-sdk.version>2.51.2</aws-sdk.version>
        <!-- No live AI in the build (docs/plans/phase-4.md §10); the ai-smoke and ai-eval profiles flip these. -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>live-ai,ai-eval</surefire.excludedGroups>
        <finalysis.live-ai>false</finalysis.live-ai>
        <finalysis.ai-eval>false</finalysis.ai-eval>
        <!-- Inputs of the accuracy evaluation (ai-eval profile); override with -D. No set: it refuses to run. -->
        <eval.set></eval.set>
        <eval.min-confidence>0.80</eval.min-confidence>
        <eval.direct-min-similarity>0.97</eval.direct-min-similarity>
        <eval.holdout.confirm>false</eval.holdout.confirm>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Compile scope: pgvector's PGvector extends the driver's PGobject. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>${pgvector.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- AI (docs/plans/phase-4.md §7). Off unless the aws profile turns them on (spring.ai.model.*=none in
             application.yml). Bedrock is named only here and in application-aws.yml; code uses Spring AI's
             ChatModel and EmbeddingModel (PackageDependencyTest). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-bedrock-converse</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-bedrock</artifactId>
        </dependency>
        <!-- Lets the AWS CLI profile in application-aws.yml be an IAM Identity Center (SSO) profile. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sso</artifactId>
            <version>${aws-sdk.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssooidc</artifactId>
            <version>${aws-sdk.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Opt-in live smoke test against the cloud model (LiveAiSmokeTest): one synthetic merchant through
             redaction and the guard, printing the category, token counts and latency only.
               cd backend && ./mvnw test -Pai-smoke
             Needs Docker (Testcontainers) and the AWS CLI profile named in application-aws.yml. -->
        <profile>
            <id>ai-smoke</id>
            <properties>
                <surefire.groups>live-ai</surefire.groups>
                <surefire.excludedGroups>ai-eval</surefire.excludedGroups>
                <finalysis.live-ai>true</finalysis.live-ai>
            </properties>
        </profile>
        <!-- Opt-in accuracy evaluation against the cloud models (CategorizationLiveEvalIT; docs/plans/phase-4.md,
             step 9a notes): the dev or holdout set through four variants, results in docs/eval/.
               cd backend && ./mvnw test -Pai-eval -Deval.set=dev -Deval.min-confidence=0.80 \
                   -Deval.direct-min-similarity=0.97
             A holdout run also needs -Deval.holdout.confirm=true, a clean working tree and no earlier holdout
             results. Needs Docker (Testcontainers) and the AWS CLI profile named in application-aws.yml. -->
        <profile>
            <id>ai-eval</id>
            <properties>
                <surefire.groups>ai-eval</surefire.groups>
                <surefire.excludedGroups>live-ai</surefire.excludedGroups>
                <finalysis.ai-eval>true</finalysis.ai-eval>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Tests tagged live-ai or ai-eval call a real cloud model; they run only with -Pai-smoke or -Pai-eval
                 (below). *IT classes aren't in surefire's default includes, so the evaluation isn't even selected
                 without its profile. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <groups>${surefire.groups}</groups>
                    <systemPropertyVariables>
                        <finalysis.live-ai>${finalysis.live-ai}</finalysis.live-ai>
                        <finalysis.ai-eval>${finalysis.ai-eval}</finalysis.ai-eval>
                        <eval.set>${eval.set}</eval.set>
                        <eval.min-confidence>${eval.min-confidence}</eval.min-confidence>
                        <eval.direct-min-similarity>${eval.direct-min-similarity}</eval.direct-min-similarity>
                        <eval.holdout.confirm>${eval.holdout.confirm}</eval.holdout.confirm>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Runs the PDF skeleton debug tool (scripts/pdf-skeleton.sh); not bound to any phase. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
            </plugin>
        </plugins>
    </build>
</project>
