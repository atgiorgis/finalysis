{
  "info": {
    "name": "Finalysis API",
    "description": "Requests for the Finalysis backend. Run against the local dev app (`./mvnw spring-boot:run`). Uses only fictional sample accounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "checkingId",
      "value": ""
    },
    {
      "key": "savingsId",
      "value": ""
    },
    {
      "key": "apexId",
      "value": ""
    },
    {
      "key": "summitId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Setup: create sample accounts",
          "item": [
            {
              "name": "Create Northfield Bank Checking",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/accounts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "accounts"
                  ]
                },
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Northfield Bank Checking\",\n  \"institution\": \"Northfield Bank\",\n  \"type\": \"CHECKING\",\n  \"lastFour\": \"1001\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('201 Created', () => pm.response.to.have.status(201));",
                      "const body = pm.response.json();",
                      "pm.collectionVariables.set('checkingId', body.id);",
                      "pm.test('Location header present', () => pm.response.to.have.header('Location'));"
                    ]
                  }
                }
              ]
            },
