                  ]
                },
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"  \",\n  \"institution\": \"Apex\",\n  \"type\": \"CREDIT_CARD\",\n  \"lastFour\": \"12a4\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                      "const fields = pm.response.json().errors.map(e => e.field);",
                      "pm.test('Reports name and lastFour', () => { pm.expect(fields).to.include('name'); pm.expect(fields).to.include('lastFour'); });"
                    ]
                  }
                }
              ]
